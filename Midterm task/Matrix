import java.util.Scanner;
public class Prac {
    public static void main(String[] args) {     // reads user input
        Scanner sc = new Scanner(System.in);     // stores the y/n answer
        char again;

        do{
            int[][] m = new int[3][3];   // 2D array: rows, 3 columns
            int[] col = new int[3];      // stores the sum of each column
            int d1 = 0, d2 = 0;          // diagonal sums
            
            // ask the user for the 9 numbers
            System.out.println("Input 9 elements: ");
            for (int i = 0; i < 3; i++)      // i = row
                for (int j = 0; j < 3; j++)   // j = column
                   m[i][j] = sc.nextInt();
            
                   // Header of the output
            System.out.println("\nDisplay Here are the Number and the  required outputs:");
            System.out.println("====================================================");
            System.out.print("Row Sum\n");
           
                   //MODIFY LINE 21 useing print only 

            // Print the table row by row
            for (int i = 0; i < 3; i++) {
                int row = 0;                      // diagonal 1: top-left to bottom - right
                System.out.printf("%12s", " ");   // diagonal 2: top-right to bottom left
                for (int j = 0; j < 3; j++) {

                     // print the column sums under the table
                    System.out.printf("%5d", m[i][j]);    // print one number
                    row += m[i][j];                      // add to the row sum
                    col[j] += m[i][j];                   // add to its column sums
                
                }
               
                System.out.printf("%10d%n", row);  // print the row sum
                d1 += m[i][i];          // diagonal 1: top left to bottom-right
                d2 += m[i][2 - i];      // diagonal 2: top-right to bottom-left
            }
             
            // print the column sums under the table
            System.out.printf("%n%-12s", "Column Sum:");
            for (int j = 0; j < 3; j++)
            System.out.printf("%5d", col[j]);
            
            // print the diagonal sums
            System.out.println("\n====================================================");
            System.out.println("Diagonal sum 1: " + d1);
            System.out.println("Diagonal sum 2: " + d2);

            // ask if the user wants to run the program again
            System.out.print("\nTRY AGAIN? (y/n): ");
            again = sc.next().charAt(0);     // read the first character typed
        } while (again == 'y');    // repeat while the answer is y
    }
}

